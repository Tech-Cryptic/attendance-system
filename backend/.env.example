# -- Database --------------------------------------------------
# PostgreSQL connection string
DATABASE_URL=postgresql://USER:PASSWORD@HOST:PORT/DBNAME

# -- Security --------------------------------------------------
# Generate strong secrets with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=REPLACE_WITH_STRONG_SECRET
HMAC_KEY=REPLACE_WITH_STRONG_SECRET
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60

# -- CORS ------------------------------------------------------
# Multiple origins: comma-separated, no spaces
CORS_ORIGINS=http://localhost:5173

# -- LLM-assisted review (optional) ----------------------------
# If unset, reviews fall back to conservative deterministic rules.
# Use OPENAI_BASE_URL for an OpenAI-compatible provider.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=https://api.openai.com/v1

# Local enrollment summary; set to 0 in production
SHOW_SEED_SUMMARY=1
