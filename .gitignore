# FaceAttend — root .gitignore

# ── OS / Editor ───────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/
.idea/
*.swp
*.swo
~$*
*.tmp

# ── Python backend ────────────────────────────────────────
backend/venv/
backend/__pycache__/
backend/**/__pycache__/
backend/**/*.pyc
backend/.env
backend/*.egg-info/
/backend/fix_name.py
/backend/test_admin.py

# ── Node / Frontend ───────────────────────────────────────
frontend/node_modules/
frontend/dist/
frontend/dev-dist/
frontend/.env
frontend/.env.local
frontend/.env.*.local

# Root workspace artifacts
/node_modules/
/package.json
/package-lock.json

# ── Secrets (never commit these) ─────────────────────────
*.pem
*.key
.env
.env.local
.env.production

# ── Documents & Images (Dissertation files) ───────────────
*.docx
*.pdf
*.png
*.webp
*.zip
*.txt
*.yaml
*.sql

# Schema and idempotent migrations are source code, not documents.
!backend/schema.sql
!backend/requirements-dev.txt
!backend/migrations/
!backend/migrations/*.sql

